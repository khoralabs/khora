# Demo / CI Docker builds (`demo/Dockerfile.agent` context = repo root).
# `bun install --frozen-lockfile` recreates `node_modules` inside the image.

# Dependencies
**/node_modules

# VCS — not needed to run bun install
.git
.gitignore
.gitattributes

# Build / cache / tooling outputs
**/dist
**/out
apps/khora/cli/dist
apps/khora/daemon/dist
**/coverage
**/.cache
**/*.tsbuildinfo
**/.eslintcache
apps/khora/release
*.tgz
*.lcov
logs
**/.DS_Store

# Local secrets (never copy into images)
.env
.env.*
!.env.example

# IDE / local tooling
.idea
.vscode
.cursor
.agents

# Internal docs / planning (not needed in images)
.brain

# Agent transcripts and plans
**/.cursor

# Tests (not run in production images)
**/*.test.ts
**/*.test.tsx
**/__tests__

# Repo-specific large / generated (see root .gitignore)
.llm-context
.memories
.obp

# Logs and temp
**/*.log
