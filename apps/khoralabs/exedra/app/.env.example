# Registry OTP auth (browser talks to registry; session cookie shared on localhost / parent domain)
BUN_PUBLIC_KHORA_REGISTRY_URL=http://localhost:4000

# Server-side session verification forwards cookies to registry
REGISTRY_URL=http://localhost:4000

# Khora host to register Exedra custodial DIDs with (optional; skipped when unset)
# KHORA_HOST_URL=http://localhost:3001
# KHORA_HOST_SLUG=my-host

# In-process stub registry (no separate registry app, SES, or crypto). When enabled, set both:
#   EXEDRA_STUB_REGISTRY=1
#   BUN_PUBLIC_EXEDRA_STUB_REGISTRY=1
# Optional fixed OTP (default 000000). Stub auth is served on Exedra (http://localhost:PORT);
# REGISTRY_URL / BUN_PUBLIC_KHORA_REGISTRY_URL are ignored while stub mode is on.
# EXEDRA_STUB_REGISTRY=1
# BUN_PUBLIC_EXEDRA_STUB_REGISTRY=1
# EXEDRA_STUB_REGISTRY_OTP=000000

# Exedra server port (Bun default 3000 if unset)
# PORT=3000

# Single-use session invite tokens (never log; generate with: openssl rand -hex 32)
INVITE_PEPPER=

# AES-256 key for encrypting custodial agent identities at rest (64 hex chars)
EXEDRA_IDENTITY_KEY=

# --- Knowledge service (memories persistence host) ---

# Hosted knowledge service URL (set automatically by `bun run dev` in exedra stack).
EXEDRA_KNOWLEDGE_SERVICE_URL=http://localhost:3003
# Bearer token for app/workflow requests (falls back to EXEDRA_INTERNAL_TOKEN in dev).
EXEDRA_KNOWLEDGE_SERVICE_TOKEN=dev-internal-token

# SQLCipher key for knowledge databases (required by knowledge service).
EXEDRA_KNOWLEDGE_SQLCIPHER_KEY=

# Legacy alias still accepted by knowledge service config during transition:
# EXEDRA_MEMORIES_SQLCIPHER_KEY=

# sqlite-vec requires a SQLite build with dynamic extension loading. Bun's bundled SQLite
# often does not support this; set SQLITE_CUSTOM_LIB to a system libsqlite3 before running.
# macOS (Homebrew):
#   export SQLITE_CUSTOM_LIB="$(brew --prefix sqlite)/lib/libsqlite3.dylib"
# Linux (Debian/Ubuntu example):
#   SQLITE_CUSTOM_LIB=/usr/lib/x86_64-linux-gnu/libsqlite3.so.0
# SQLITE_CUSTOM_LIB=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib

# Vector embeddings (Google Gemini via @ai-sdk/google).
# Exedra uses gemini-embedding-2-preview for vector search.
# Without this key, memory search falls back to lexical-only (no vector arm).
GOOGLE_GENERATIVE_AI_API_KEY=

# Vector search output dimension preset when embedding queries (also overridable per request).
# L=768, M=1536 (default when unset), H=3072. Should match vectors stored in the namespace.
# MEMORIES_SEARCH_EMBEDDING_PRESET=M

# --- Authz service (central grant store) ---

# When set, the app uses the HTTP authz service instead of an in-process ephemeral store.
AUTHZ_SERVICE_URL=http://localhost:3001
AUTHZ_INTERNAL_TOKEN=dev-authz-token

# --- Chat service (central chat persistence) ---

# When set, the app proxies chat operations to the HTTP chat service.
EXEDRA_CHAT_SERVICE_URL=http://localhost:3002
# Shared with EXEDRA_INTERNAL_TOKEN for workflow + chat service auth.
# CHAT_INTERNAL_TOKEN=dev-internal-token
EXEDRA_CHAT_DB_PATH=./data/exedra-chat.db

# Browser websocket subscriptions: ws(s)://<app-host>/ws/chat/threads/:threadId

# Shared secret for /internal/memories/* (workflow service sends Authorization: Bearer ...)
EXEDRA_INTERNAL_TOKEN=

# Render API key + workflow slug used to dispatch integrateBelief tasks from PATCH handler
RENDER_API_KEY=
# Use the local Render Workflows task server while developing workflows locally.
# Start a workflow with: render workflows dev -- bun src/main.ts
RENDER_USE_LOCAL_DEV=true
RENDER_LOCAL_DEV_URL=http://localhost:8120
RENDER_INTEGRATION_LOCAL_DEV_URL=http://localhost:8121
RENDER_DOCUMENT_LOCAL_DEV_URL=http://localhost:8122
# RENDER_INTEGRATION_WORKFLOW_SLUG=integrate-memory
# RENDER_DOCUMENT_WORKFLOW_SLUG=process-document
RENDER_GENERATE_RESPONSE_WORKFLOW_SLUG=generate-response

# --- Belief integration workflow (Render Workflows) ---

# Required for document upload. Works with AWS S3 or MinIO (set endpoint below).
EXEDRA_DOCUMENTS_S3_BUCKET=
EXEDRA_DOCUMENTS_S3_PREFIX=exedra
# EXEDRA_DOCUMENTS_S3_ENDPOINT=http://127.0.0.1:9000  # MinIO / local S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Litestream → S3 (continuous backup of exedra.db + memories/) ---

# Enable Litestream sidecar in production (`bun run start` reads this; dev uses `bun run dev` without it).
# EXEDRA_LITESTREAM=1

# --- Production: AWS S3 (omit LITESTREAM_S3_ENDPOINT; use IAM role or AWS keys) ---
# LITESTREAM_S3_BUCKET=khora-backups-prod
# LITESTREAM_S3_KEY_PREFIX=exedra
# LITESTREAM_S3_REGION=us-east-1
# LITESTREAM_LOG_LEVEL=error
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Local MinIO (see apps/s3/README.md) ---
# LITESTREAM_S3_ENDPOINT=http://127.0.0.1:9000
# LITESTREAM_S3_BUCKET=khora-backups
# LITESTREAM_S3_KEY_PREFIX=exedra
# LITESTREAM_ACCESS_KEY_ID=minioadmin
# LITESTREAM_SECRET_ACCESS_KEY=minioadmin

# Optional: path to litestream binary (default apps/exedra/.bin/litestream from preinstall)
# LITESTREAM_BIN_PATH=

# Restore examples:
#   litestream restore -o ./data/exedra.db s3://bucket/exedra/litestream/exedra.sqlite
#   litestream restore -o ./data/memories/org-id.db s3://bucket/exedra/litestream/memories/org-id.db

# --- Analytics (see apps/umami/README.md) ---
# Server-side event forwarding (Exedra /api/events → Umami):
# UMAMI_URL=http://localhost:3001               # local dev
# UMAMI_URL=http://<umami-service-name>:3000    # Render internal hostname (production)
# UMAMI_WEBSITE_ID=

# Client-side page views (Umami tracker script — all HTML entrypoints via render-route.tsx):
# BUN_PUBLIC_UMAMI_SCRIPT_URL=https://umami-7h3o.onrender.com/script.js
# BUN_PUBLIC_UMAMI_WEBSITE_ID=f73f8d82-e400-4a62-bd42-e476045e9655

# --- Telemetry (see apps/otel/README.md) ---
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=exedra
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=khoralabs,deployment.environment=production
# `bun run start` sets OTEL_SERVICE_NAME and service.namespace by default when unset.
# Grafana credentials go in apps/otel/.env on the collector — not in Exedra.
# Build/run collector from repo root:
#   docker build -t khora-otel-collector -f apps/otel/Dockerfile .
#   docker run -d --name khora-otel-collector --env-file apps/otel/.env -p 4318:4318 khora-otel-collector
