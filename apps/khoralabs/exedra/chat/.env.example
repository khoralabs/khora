# Chat service port (default 3002)
# PORT=3002

# SQLite path for chat persistence (default ./data/exedra-chat.db)
# EXEDRA_DATA_DIR=./data
EXEDRA_CHAT_DB_PATH=./data/exedra-chat.db

# Internal token for app/workflow requests (falls back to EXEDRA_INTERNAL_TOKEN)
EXEDRA_INTERNAL_TOKEN=dev-internal-token
# CHAT_INTERNAL_TOKEN=dev-internal-token
