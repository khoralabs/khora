# Chat service port (default 3002)
# PORT=3002

# SQLite path for local chat persistence (default ./data/exedra-chat.db).
# When unset and TURSO_DATABASE_URL is set, the chat service uses Turso instead.
# EXEDRA_DATA_DIR=./data
EXEDRA_CHAT_DB_PATH=./data/exedra-chat.db

# Turso/libSQL (production). Omit EXEDRA_CHAT_DB_PATH to use Turso when both are set.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Internal token for app/workflow requests (falls back to EXEDRA_INTERNAL_TOKEN)
EXEDRA_INTERNAL_TOKEN=dev-internal-token
# CHAT_INTERNAL_TOKEN=dev-internal-token
