{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@khoralabs/memories-core": ["node_modules/@khoralabs/memories-core/src/index.ts"],
      "@khoralabs/memories-core/helpers": [
        "node_modules/@khoralabs/memories-core/src/helpers/index.ts"
      ],
      "@khoralabs/memories-autolink": ["node_modules/@khoralabs/memories-autolink/src/index.ts"],
      "zod": ["node_modules/zod/index.d.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "src/**/*",
    "../../shared/belief-integration.ts",
    "../../shared/belief-agent-instructions.ts",
    "../../shared/search-hit-wire.ts",
    "../../app/src/server/memories/exedra-ontology.ts"
  ]
}
