# Knowledge service port (default 3003)
# PORT=3003

# SQLite data directory for memories-service storage (default {EXEDRA_DATA_DIR}/knowledge)
# EXEDRA_DATA_DIR=./data
# EXEDRA_KNOWLEDGE_DATA_DIR=./data/knowledge

# SQLCipher key for knowledge databases (required)
EXEDRA_KNOWLEDGE_SQLCIPHER_KEY=

# sqlite-vec requires a SQLite build with dynamic extension loading.
# macOS (Homebrew):
#   export SQLITE_CUSTOM_LIB="$(brew --prefix sqlite)/lib/libsqlite3.dylib"
# SQLITE_CUSTOM_LIB=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib

# Auth for memories-service HTTP (none | server-admin)
MEMORIES_SERVICE_AUTH=server-admin
MEMORIES_SERVICE_ADMIN_TOKEN=dev-internal-token

# Exedra app/workflows use these to reach the knowledge service:
# EXEDRA_KNOWLEDGE_SERVICE_URL=http://localhost:3003
# EXEDRA_KNOWLEDGE_SERVICE_TOKEN=dev-internal-token
