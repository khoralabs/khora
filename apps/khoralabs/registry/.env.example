# Registry service (local dev)
PORT=4000
REGISTRY_DATABASE_PATH=./data/registry.sqlite
REGISTRY_URL=http://localhost:4000
BETTER_AUTH_SECRET=dev-only-insecure-secret-replace-me-32chars

# Default Atrium host for access-token requests (v1 single-host)
REGISTRY_DEFAULT_HOST_SLUG=khora-local
REGISTRY_DEFAULT_HOST_URL=http://localhost:8788

# Comma-separated client app origins (CORS + Better Auth trustedOrigins)
REGISTRY_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Atrium internal mint + invite hashing
ATRIUM_INTERNAL_SECRET=
ATRIUM_INVITE_PEPPER=dev-invite-pepper
ATRIUM_BASE_URL=http://localhost:8788

# Email (optional in dev — set REGISTRY_AUTH_OTP_LOG=1 and skip SES)
SES_FROM_ADDRESS=
AWS_REGION=us-east-1
REGISTRY_AUTH_OTP_LOG=1

# Optional production cookie domain
# REGISTRY_COOKIE_DOMAIN=.khoralabs.com
