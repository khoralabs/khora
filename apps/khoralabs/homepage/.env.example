# Copy to .env. Bun loads .env automatically when you `bun run dev`.

# Valkey/Redis waitlist KV (apps/redis Docker image)
REDIS_URL=redis://localhost:6379

# Atrium server for invite minting
ATRIUM_BASE_URL=http://localhost:8788
ATRIUM_INTERNAL_SECRET=change-me-long-random-secret

# AWS SES (invite email delivery)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=noreply@example.com

# Workflow SDK local world (default; optional override)
# WORKFLOW_TARGET_WORLD=local
# WORKFLOW_LOCAL_DATA_DIR=.workflow-data
