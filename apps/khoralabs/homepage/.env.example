# Copy to .env. Bun loads .env automatically when you `bun run dev`.

PORT=3000

# Registry URL for waitlist signup (Better Auth OTP on homepage)
BUN_PUBLIC_KHORA_REGISTRY_URL=http://localhost:4000

# Slack contact notifications (chat.postMessage)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CONTACT_CHANNEL_ID=C0123456789

# Seconds to wait for OTP before sending unconfirmed Slack message (matches Better Auth OTP default)
CONTACT_QUEUE_TTL_SECONDS=300
