{
  "name": "@khoralabs/khora-server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "bun ../../../scripts/install-litestream.ts --output .bin/litestream",
    "start": "NODE_ENV=production bun run scripts/start-khora.ts",
    "start:server": "bun run src/index.ts",
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:darwin-arm64": "bun run scripts/build.ts bun-darwin-arm64",
    "build:linux-x64": "bun run scripts/build.ts bun-linux-x64",
    "build:linux-arm64": "bun run scripts/build.ts bun-linux-arm64",
    "build:all": "bun run scripts/build.ts bun-darwin-arm64 && bun run scripts/build.ts bun-linux-x64 && bun run scripts/build.ts bun-linux-arm64"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.0",
    "@khoralabs/agent-capabilities": "^0.2.0",
    "@khoralabs/colonnade-persistence": "workspace:*",
    "@khoralabs/colonnade-persistence-sqlite": "workspace:*",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/khora-auth-sqlite": "workspace:*",
    "@khoralabs/admin-token": "workspace:*",
    "@khoralabs/khora-contracts": "workspace:*",
    "@khoralabs/khora-host": "workspace:*",
    "@khoralabs/khora-host-sqlite": "workspace:*",
    "@khoralabs/khora-invites": "workspace:*",
    "@khoralabs/khora-invites-sqlite": "workspace:*",
    "@khoralabs/khora-server-http": "workspace:*",
    "@khoralabs/khora-transport": "workspace:*",
    "@khoralabs/registry-catalog-contracts": "workspace:*",
    "@khoralabs/memories-agents": "^0.5.15",
    "@khoralabs/memories-node": "^0.5.15",
    "@khoralabs/colonnade-crypto": "workspace:*",
    "@khoralabs/percolator-sqlite": "workspace:*",
    "@khoralabs/sqlite-crypto": "^0.1.0",
    "@khoralabs/sqlite-migrate": "^0.1.0",
    "@khoralabs/observability": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^6",
    "ajv": "^8",
    "pino": "^10.3.1",
    "sqlite-vec": "^0.1.10-alpha.4",
    "umap-js": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
