# Copy to .env and adjust. Bun loads .env automatically when you `bun run`.
#
# Persistence layout (cross-package):
#   @khoralabs/colonnade-persistence → packages/colonnade/impl/ts/.env.example
#   Catalog/social adapters → apps/khora/server/src/persistence/
#   @khoralabs/khora-invites → packages/khora/invites (env read in server bootstrap)

# --- logging (stderr; stdout reserved for optional stdio unary ingress) ---
LOG_LEVEL=info

# --- Telemetry ---
# OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://127.0.0.1:4318 for local collector
# OTEL_SERVICE_NAME=khora-server   # Defaults to "khora-server" via start script
# OTEL_RESOURCE_ATTRIBUTES=        # e.g. deployment.environment=production

# --- required: host persistence root ---
# Under KHORA_DATA_DIR (default ./data when unset):
#   khora-catalog.sqlite   — catalog KV, standing queries, social graph, …
#   khora-memories.sqlite  — Memories search index (when KHORA_MEMORIES enabled)
#   cells/                 — colonnade shard SQLite files (inbox/outbox)
KHORA_DATA_DIR=./data

# Optional per-file overrides (migration): KHORA_CATALOG_PATH,
# KHORA_CELLS_DIR, KHORA_MEMORIES_DB_PATH

# Pool size for assignPrincipalToCell shards (default 16). Maps to createSqliteColonnadeCluster poolCount.
# KHORA_CELL_POOL_COUNT=16

# Cell SQLite: Bun Workers (default) vs main thread — same knob as colonnade bench `--cell-workers`.
# Unset / 1 / on = Workers; 0 / off / false / no = main-thread bun:sqlite (like bench sqlite without --cell-workers).
# KHORA_COLONNADE_CELL_WORKERS=1

# --- HTTP ---
# Listening port (default 8788 if unset or invalid)
PORT=8788

# --- host discovery & registry ---
# GET /.well-known/khora — slug, baseUrl, registryUrl, endpoint paths
# KHORA_HOST_SLUG=my-lab
# Public URL when behind TLS/reverse proxy (default http://127.0.0.1:$PORT)
# KHORA_PUBLIC_BASE_URL=http://127.0.0.1:8788
# KHORA_REGISTRY_URL=http://localhost:4000
# Max registered principals on this host (optional; omit = unlimited). Overrides stored host spec.
# KHORA_POPULATION_LIMIT=100

# Registry integration is configured from /admin/registry (persisted in catalog host spec projection).
# Env vars below are optional bootstrap overrides:
# KHORA_HOST_DISPLAY_NAME=My local host
# KHORA_REGISTRY_TRUST_BASE_URL_ORIGIN=1
# KHORA_REGISTRY_PARTICIPATE=1   # legacy startup register when slug set via env

# Optional relay tenant key for catalog key prefixes (library default "relay" when unset).
# Passed through to catalog persistence as tenantKey.
# KHORA_RELAY_TENANT_KEY=

# --- parallel ingress (optional; default is Bun HTTP only) ---
# Unary: unset / "http" = HTTP only; "stdio" = NDJSON stdin/out alongside HTTP
# KHORA_HOST_UNARY_TRANSPORT=http
# KHORA_HOST_UNARY_TRANSPORT=stdio

# Duplex: unset / "off" = none; "unix" = Unix socket (opaque binary after JSON handshake line)
# KHORA_HOST_DUPLEX_INGRESS=off
# KHORA_HOST_DUPLEX_INGRESS=unix
# KHORA_HOST_DUPLEX_UNIX_PATH=/tmp/khora-duplex.sock

# --- operator admin console (human network managers) ---
# When set (>= 16 chars), enables GET /admin and /admin/api/* session auth.
# KHORA_CONSOLE_ROOT_TOKEN=change-me-long-random-secret
# KHORA_CONSOLE_AUTH=root-token

# --- invites (read by @khoralabs/khora-invites in bootstrap-khora.ts) ---
# Required if KHORA_INVITE_REQUIRED=1 or KHORA_INVITE_SEED_TOKENS is non-empty
# KHORA_INVITE_PEPPER=change-me-long-random-secret
# KHORA_INVITE_REQUIRED=1
# Max invites minted per successful registration (default 10, cap 500)
# KHORA_INVITES_PER_REGISTRATION=10
# Bootstrap plaintext tokens (comma- or newline-separated); hashed with pepper on startup
# KHORA_INVITE_SEED_TOKENS=

# --- rate limits (requests per minute; omit to use defaults) ---
# KHORA_RL_REGISTER_PER_MIN_PER_IP=30
# KHORA_RL_REGISTER_PER_MIN_PER_DID=15
# KHORA_RL_POSTS_PER_MIN_PER_DID=120
# KHORA_RL_TOPICS_PER_MIN_PER_DID=120
# KHORA_RL_PROFILE_PATCH_PER_MIN_PER_DID=60
# KHORA_RL_INBOX_PER_MIN_PER_DID=120
# KHORA_RL_DEFAULT_PER_MIN_PER_IP=900
# KHORA_RL_INVITE_PREVIEW_PER_MIN_PER_IP=30
# KHORA_RL_INVITES_LIST_PER_MIN_PER_DID=60
# KHORA_RL_RELATIONSHIPS_LIST_PER_MIN_PER_DID=60

# --- Memories search index (on by default; db at {KHORA_DATA_DIR}/khora-memories.sqlite) ---
# KHORA_MEMORIES=0
# KHORA_MEMORIES_NAMESPACE_ROOT=global
# KHORA_EMBEDDING_PROVIDER=google
# KHORA_EMBEDDING_MODEL=gemini-embedding-2-preview
# KHORA_EMBEDDING_RESOLUTION=M
# KHORA_EMBEDDING_API_KEY=

# --- Encryption at rest (required) ---
# SQLCipher whole-file keys (≥16 chars). Same key must be used across restarts and Litestream restores.
KHORA_SQLCIPHER_KEY=dev-khora-sqlcipher-key!!
# Field-level AES-GCM for post outbox payloads (32-byte hex or ≥32 UTF-8 bytes). Separate from SQLCipher.
KHORA_OUTBOX_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Litestream backup (optional): replicate catalog and cell shards to S3 ---
# When enabled, `bun run start` runs Litestream next to the server (see scripts/start-khora.ts).
# KHORA_LITESTREAM=1
#
# --- Production: AWS S3 (omit LITESTREAM_S3_ENDPOINT; use IAM role or AWS keys) ---
# LITESTREAM_S3_BUCKET=khora-backups-prod
# LITESTREAM_S3_KEY_PREFIX=hosts/khora-relay/litestream
# LITESTREAM_S3_REGION=us-east-1
# LITESTREAM_LOG_LEVEL=error
# AWS_ACCESS_KEY_ID=          # optional when task/instance IAM role is attached
# AWS_SECRET_ACCESS_KEY=
#
# --- Local dev: MinIO (see apps/s3/README.md) ---
# Build/run from repo root: docker build -t khora-khora-minio -f apps/s3/Dockerfile .
# LITESTREAM_S3_ENDPOINT=http://127.0.0.1:9000
# LITESTREAM_S3_BUCKET=khora-backups
# LITESTREAM_S3_KEY_PREFIX=khora/litestream
# LITESTREAM_ACCESS_KEY_ID=minioadmin
# LITESTREAM_SECRET_ACCESS_KEY=minioadmin
#
# Optional: path to litestream binary (default apps/khora/server/.bin/litestream from preinstall)
# LITESTREAM_BIN_PATH=
#
# Restore: catalog — `litestream restore -o <local-path> s3://bucket/.../catalog.sqlite`
# Cell shards use directory watcher layout — restore each shard URL, e.g.
#   litestream restore -o ./data/cells/foo.sqlite s3://bucket/prefix/cells/foo.sqlite
# https://litestream.io/guides/directory-watcher/#restoring-databases
#
# --- Docker (linux/amd64 image sets these by default) ---
# SQLCIPHER_CUSTOM_LIB=/usr/lib/x86_64-linux-gnu/libsqlcipher.so.1
# SQLITE_CUSTOM_LIB=/usr/lib/x86_64-linux-gnu/libsqlite3.so.0
# See apps/khora/server/DOCKER.md
