{
  "name": "@khoralabs/khora-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/run-khora-inbox-daemon.ts",
    "./run": "./src/run-khora-inbox-daemon.ts",
    "./control-pid": "./src/control-pid.ts",
    "./daemon-config": "./src/daemon-config.ts",
    "./plugins-from-config": "./src/plugins-from-config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run ./src/index.ts",
    "build:darwin-arm64": "bun run scripts/build.ts bun-darwin-arm64",
    "build:linux-x64": "bun run scripts/build.ts bun-linux-x64",
    "build:linux-arm64": "bun run scripts/build.ts bun-linux-arm64",
    "build:all": "bun run scripts/build.ts bun-darwin-arm64 && bun run scripts/build.ts bun-linux-x64 && bun run scripts/build.ts bun-linux-arm64"
  },
  "dependencies": {
    "@khoralabs/did-key-identity": "^0.1.0",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/khora-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
