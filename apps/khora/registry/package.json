{
  "name": "@khoralabs/khora-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "bun ../../../scripts/install-litestream.ts --output .bin/litestream",
    "build:web": "bun-web build",
    "dev": "bun --env-file=.env --hot src/index",
    "prestart": "bun run build:web",
    "start": "NODE_ENV=production bun scripts/start-registry.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1050.0",
    "@khoralabs/bun-web": "workspace:*",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/khora-console": "workspace:*",
    "@khoralabs/sqlite-crypto": "workspace:*",
    "@khoralabs/users": "workspace:*",
    "@khoralabs/users-auth": "workspace:*",
    "@khoralabs/users-react": "workspace:*",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
  }
}
