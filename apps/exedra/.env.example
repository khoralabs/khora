# Registry OTP auth (browser talks to registry; session cookie shared on localhost / parent domain)
BUN_PUBLIC_KHORA_REGISTRY_URL=http://localhost:4000

# Server-side session verification forwards cookies to registry
REGISTRY_URL=http://localhost:4000

# In-process stub registry (no separate registry app, SES, or crypto). When enabled, set both:
#   EXEDRA_STUB_REGISTRY=1
#   BUN_PUBLIC_EXEDRA_STUB_REGISTRY=1
# Optional fixed OTP (default 000000). Stub auth is served on Exedra (http://localhost:PORT);
# REGISTRY_URL / BUN_PUBLIC_KHORA_REGISTRY_URL are ignored while stub mode is on.
# EXEDRA_STUB_REGISTRY=1
# BUN_PUBLIC_EXEDRA_STUB_REGISTRY=1
# EXEDRA_STUB_REGISTRY_OTP=000000

# Exedra server port (Bun default 3000 if unset)
# PORT=3000

# SQLite data directory (default ./data — holds exedra.db and memories/)
# EXEDRA_DATA_DIR=./data

# Single-use session invite tokens (never log; generate with: openssl rand -hex 32)
INVITE_PEPPER=

# AES-256 key for encrypting custodial agent identities at rest (64 hex chars)
EXEDRA_IDENTITY_KEY=

# Interview agent (Vercel AI SDK)
AI_API_KEY=
AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1
