# Base URL of the Khora server (defaults to https://k-0.khoralabs.com)
VELLUM_BASE_URL=http://localhost:8788

# Room to connect to (required)
VELLUM_ROOM_ID=your-room-id

# WebSocket URL for the room (required)
VELLUM_ROOM_WS_URL=ws://localhost:8788/rooms/your-room-id/ws

# Path to the Ed25519 agent identity key (defaults to ~/.vellum/agent.key)
VELLUM_AGENT_KEY_PATH=~/.vellum/agent.key

# Local directory for room databases and control files (defaults to ~/.vellum/data)
VELLUM_DATA_DIR=~/.vellum/data

# Output structured JSON logs instead of human-readable text (set to 1 to enable)
VELLUM_DAEMON_JSON=
