# Registry service (local dev)
PORT=4000
REGISTRY_DATABASE_PATH=./data/registry.sqlite
# Public URL for Better Auth and khora link verification links (must match CLI KHORA_REGISTRY_URL)
REGISTRY_URL=http://localhost:4000
# Required (≥32 chars). Registry refuses to start if missing or too short.
BETTER_AUTH_SECRET=dev-only-insecure-secret-replace-me-32chars

# --- Telemetry ---
# LOG_LEVEL=info                        # Pino log level (trace|debug|info|warn|error). Default: info
# OTEL_EXPORTER_OTLP_ENDPOINT=          # OTLP HTTP endpoint (e.g. http://127.0.0.1:4318 for local collector)
# OTEL_SERVICE_NAME=khora-registry      # Defaults to "khora-registry" when running via `bun run start`
# OTEL_RESOURCE_ATTRIBUTES=            # Optional extra resource attrs (key=value,key2=value2)

# Activate pending hosts:
#   POST /v1/ops/hosts/:id/activate with Authorization: Bearer $REGISTRY_CONSOLE_ROOT_TOKEN
#
# Host registration trust (self-serve hosts):
#   REGISTRY_REGISTRATION_TRUST=manual   # default — operator must activate
#   REGISTRY_REGISTRATION_TRUST=health   # auto-activate when health probe passes at register/claim
#   REGISTRY_REGISTRATION_TRUST=open     # reserved; same as health today
#   REGISTRY_REGISTRATION_REQUIREMENTS=  # optional JSON override of requirement IDs
#
# CORS / Better Auth trusted origins: hosts register explicit origins via /v1/hosts/:slug/registry
# or operator PATCH /v1/ops/hosts/:id/registry
#
# Behind a reverse proxy, set TRUSTED_PROXIES (or REGISTRY_TRUSTED_PROXIES) to the proxy IP(s)
# so rate limits use X-Forwarded-For / X-Real-IP.
# TRUSTED_PROXIES=10.0.0.1

# Email (optional in dev — set REGISTRY_AUTH_OTP_LOG=1 and skip SES)
SES_FROM_ADDRESS=
AWS_REGION=us-east-1
REGISTRY_AUTH_OTP_LOG=1

# Cross-subdomain session cookies (registry + apps on subdomains of the same parent).
# Option A — explicit cookie domain:
# REGISTRY_COOKIE_DOMAIN=.khoralabs.com
# Option B — derive `.parent` when REGISTRY_URL hostname is on that parent:
# REGISTRY_COOKIE_PARENT_DOMAIN=khoralabs.com

# Operator API (≥16 chars enables Bearer auth for /v1/ops/*).
# Activate/suspend/reactivate/delete hosts and accounts; approve origin/quota requests.
REGISTRY_CONSOLE_ROOT_TOKEN=

# --- Encryption at rest (required) ---
# SQLCipher whole-file key for registry.sqlite (≥16 chars). Required for Litestream restore with encrypted DB.
REGISTRY_SQLCIPHER_KEY=dev-registry-sqlcipher-key!

# --- Litestream backup (optional): replicate registry.sqlite to S3 ---
# When enabled, `bun run start` runs Litestream next to the server (see scripts/start-registry.ts).
# REGISTRY_LITESTREAM=1
#
# --- Production: AWS S3 (omit LITESTREAM_S3_ENDPOINT; use IAM role or AWS keys) ---
# LITESTREAM_S3_BUCKET=khora-backups-prod
# LITESTREAM_S3_KEY_PREFIX=registry/litestream
# LITESTREAM_S3_REGION=us-east-1
# LITESTREAM_LOG_LEVEL=error
#
# --- Local dev: MinIO (see apps/s3/README.md) ---
# LITESTREAM_S3_ENDPOINT=http://127.0.0.1:9000
# LITESTREAM_S3_BUCKET=khora-backups
# LITESTREAM_S3_KEY_PREFIX=registry/litestream
# LITESTREAM_ACCESS_KEY_ID=minioadmin
# LITESTREAM_SECRET_ACCESS_KEY=minioadmin
