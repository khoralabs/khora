{
  "name": "@khoralabs/khora-registry-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "bun ./scripts/install-litestream.ts",
    "dev": "bun --env-file=.env --hot src/index",
    "start": "NODE_ENV=production bun scripts/start-registry.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:darwin-arm64": "bun run scripts/build.ts bun-darwin-arm64",
    "build:linux-x64": "bun run scripts/build.ts bun-linux-x64",
    "build:linux-arm64": "bun run scripts/build.ts bun-linux-arm64",
    "build:all": "bun run scripts/build.ts bun-darwin-arm64 && bun run scripts/build.ts bun-linux-x64 && bun run scripts/build.ts bun-linux-arm64"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1050.0",
    "@khoralabs/colonnade": "workspace:*",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/observability": "workspace:*",
    "@khoralabs/khora-registry": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "better-auth": "^1.6.11",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "catalog:"
  }
}
