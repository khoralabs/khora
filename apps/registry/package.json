    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/admin-token": "workspace:*",
    "@khoralabs/registry-accounts": "workspace:*",
    "@khoralabs/registry-accounts-react": "workspace:*",
    "@khoralabs/registry-auth": "workspace:*",
    "@khoralabs/registry-host": "workspace:*",
    "@khoralabs/registry-persistence": "workspace:*",
    "@khoralabs/registry-sqlite": "workspace:*",
    "@khoralabs/registry-turso-serverless": "workspace:*",
    "@khoralabs/registry-catalog": "workspace:*",
    "@khoralabs/registry-catalog-react": "workspace:*",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "@khoralabs/colonnade": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
