    "@khoralabs/observability": "workspace:*",
    "@khoralabs/registry": "workspace:*",
    "@libsql/client": "^0.15.15",
    "@libsql/kysely-libsql": "^0.4.0",
    "@opentelemetry/api": "^1.9.0",
    "better-auth": "^1.6.11",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.8",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
