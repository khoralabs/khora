# PostgreSQL connection string — local dev uses apps/postgres; production uses Render Managed PG.
DATABASE_URL=postgresql://umami:umami@localhost:5432/umami

# Required: random secret used to generate authentication tokens (generate with: openssl rand -hex 32).
APP_SECRET=

# Required: allow server-side events forwarded from Exedra (bypasses Umami's bot-detection heuristic).
DISABLE_BOT_CHECK=1

# Optional: port (default 3000).
# PORT=3000
