# Matchmaking demo — optional overrides (Bun loads `.env` automatically)

# Virtual account / subject key: co-keys memory namespaces, OBP negotiator id segment, and
# `invocationContext` (see `resolveMatchmakingSubjectId`). Default: `_user_` (demo).
# SUBJECT_ID=_user_
# MATCHMAKING_SUBJECT_ID — alias for SUBJECT_ID
# If you change SUBJECT_ID or the namespace path layout, re-seed or clear SQLite so seeds land in the new paths:
# OBP_DEMO_FORCE_MEMORIES_RESEED=1

# --- Memories (graph + lexical mirror + dev thread logs) ---
#
# MEMORIES_DIR — directory root for everything below (default: `.memories` under cwd).
#   Resolved by `resolveMemoriesRoot()` in `src/lib/memories/persisted-memories.ts`.
#   Typical contents:
#   {MEMORIES_DIR}/memories.sqlite
#     — single SQLite DB for all persona namespaces (unless you override with MEMORIES_DB).
#   {MEMORIES_DIR}/namespaces/<namespace_path>/store.jsonl
#     — one JSONL file per memory namespace (required mirror for `createMatchmakingMemoriesBundle`).
#     Example: `namespaces/obp_demo/matchmaking/subjects/_user_/personas/p1/store.jsonl`
#   {MEMORIES_DIR}/negotiation-dev/<runId>/thread.jsonl
#     — dev WebSocket drawer / thread replay for that invite `runId` (not the OBP graph).
# MEMORIES_DIR=.memories
#
# MEMORIES_DB — explicit path to the **Memories** SQLite file (optional).
#   When unset: `{MEMORIES_DIR}/memories.sqlite`.
#   When set: use this file as the DB path passed to `createMatchmakingMemoriesBundle`; JSONL mirrors
#   and namespace layout still use MEMORIES_DIR for paths under `namespaces/...`.
#   Use an absolute path if the DB should live outside MEMORIES_DIR.
# MEMORIES_DB=/absolute/path/to/memories.sqlite

# --- OBP (negotiation graph + optional step log) ---
#
# OBP graph + step log root (default: `.obp` under cwd). Each API `runId` gets a subfolder:
#   {OBP_DIR}/{runId}/obp.sqlite   — authoritative negotiation graph (override name with OBP_SQLITE)
#   {OBP_DIR}/{runId}/obp-steps.jsonl — append-only mutation log when dev drawer or OBP_STEP_LOG is on
# OBP_DIR=.obp

# SQLite filename inside each run directory (default: obp.sqlite)
# OBP_SQLITE=obp.sqlite

# Force in-memory OBP only (no files; ignores runId for disk). Useful for CI.
# OBP_MEMORY=1

# Log OBP mutations to obp-steps.jsonl without the WebSocket dev drawer (e.g. headless smoke)
# OBP_STEP_LOG=1
