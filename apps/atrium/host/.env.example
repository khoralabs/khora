# --- Required ---
ATRIUM_DB_PATH=./tmp/atrium/atrium.db
ATRIUM_INVITE_PEPPER=replace-with-32-bytes-hex
MEMORIES_DIR=./tmp/atrium/.memories

# Optional: AI provider for embeddings.
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_SDK_LOG_WARNINGS=false

# --- SQLite maintenance (optional; defaults shown) ---
# ATRIUM_SQLITE_WAL_CHECKPOINT_INTERVAL_MS=60000
# ATRIUM_SQLITE_ANALYZE_INTERVAL_MS=21600000

# --- Litestream replication (optional) ---
# Leave LITESTREAM_S3_BUCKET unset to disable replication entirely.
# When set, the host runs `litestream restore -if-replica-exists` on boot and
# spawns `litestream replicate` as a supervised child process.
#
# LITESTREAM_S3_BUCKET=atrium-db
# LITESTREAM_S3_PATH=prod
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
#
# For non-AWS S3-compatible providers (Cloudflare R2, Backblaze B2, MinIO):
# LITESTREAM_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# LITESTREAM_S3_FORCE_PATH_STYLE=true
# LITESTREAM_S3_REGION=us-east-1
#
# Tunables (defaults shown).
# LITESTREAM_SYNC_INTERVAL=1s
# LITESTREAM_SNAPSHOT_INTERVAL=1h
# LITESTREAM_RETENTION=72h
# LITESTREAM_BIN_PATH=apps/atrium/host/.bin/litestream
# LITESTREAM_CONFIG_DIR=<dirname(ATRIUM_DB_PATH)>/.litestream
