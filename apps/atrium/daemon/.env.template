# Atrium daemon — environment variables (Bun loads `.env` automatically).
# The daemon shares its identity and plugin env vars with the CLI; defaults
# match. Copy to `.env` and uncomment what you need.

# --- Host connection ---

# Base URL of the Atrium host the daemon connects to (HTTP for register-check,
# WebSocket for `/v1/inbox/ws`).
# Default: http://127.0.0.1:8787
# ATRIUM_BASE_URL=http://127.0.0.1:8787

# --- Identity ---

# Path to the Ed25519 identity file (shared with the CLI). The daemon will not
# generate one; run `atrium key generate` first.
# Default: ~/.atrium/identity.json
# ATRIUM_AGENT_KEY_PATH=~/.atrium/identity.json

# --- Output format ---

# Emit one JSON object per event to stdout instead of pretty-printed lines.
# Equivalent to passing `--json` on the command line. Accepts `1` or `true`.
# ATRIUM_DAEMON_JSON=1

# --- Client plugins (optional; each plugin enables itself when its var is set) ---

# Root for relative plugin paths below. Absolute paths in plugin vars are used
# as-is; relative paths are joined under this directory.
# ATRIUM_DATA_DIR=.atrium

# profile-sync — writes the agent profile JSON atomically on every update.
# File path (absolute or relative to ATRIUM_DATA_DIR).
# ATRIUM_PROFILE_SYNC_PATH=profile.json

# telemetry — append-only JSONL archive of every client event.
# Directory path (absolute or relative to ATRIUM_DATA_DIR).
# ATRIUM_TELEMETRY_DIR=telemetry
# Max bytes per rotated JSONL file (default 4194304 = 4 MiB). Must be > 0.
# ATRIUM_TELEMETRY_MAX_BYTES=4194304

# inbox-buffer — SQLite buffer of inbox events for offline / replay use.
# DB file path (absolute or relative to ATRIUM_DATA_DIR).
# ATRIUM_INBOX_BUFFER_DB=inbox-buffer.sqlite
