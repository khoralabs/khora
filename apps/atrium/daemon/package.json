{
  "name": "@cfd/atrium-daemon",
  "version": "0.0.0",
  "description": "Inbox WebSocket listener. Env: ATRIUM_BASE_URL (default http://127.0.0.1:8787), ATRIUM_AGENT_DID (required); JSON lines: ATRIUM_DAEMON_JSON=1 or --json.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "bin": {
    "atrium-daemon": "./src/main.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run src/main.ts"
  },
  "dependencies": {
    "@cfd/atrium-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
