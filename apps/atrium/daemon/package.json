{
  "name": "@khoralabs/atrium-daemon",
  "version": "0.0.0",
  "description": "Atrium inbox daemon: observes `/v1/inbox/ws` and persists inbox OBP SQLite under `<dataDir>/obp/inbox`. JSON logs: ATRIUM_DAEMON_JSON=1 or --json.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugins": {
      "types": "./src/plugins.ts",
      "import": "./src/plugins.ts",
      "default": "./src/plugins.ts"
    },
    "./bin": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/main.ts",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "@khoralabs/atrium-auth": "workspace:*",
    "@khoralabs/atrium-client": "workspace:*",
    "@khoralabs/atrium-plugin-inbox-buffer": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
