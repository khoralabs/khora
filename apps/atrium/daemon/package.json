{
  "name": "@khoralabs/atrium-daemon",
  "version": "0.0.0",
  "description": "Atrium long-lived processes: inbox observer (default) and per-room WebSocket holders for Atrium rooms / OBP v2 frame sessions (ATRIUM_DAEMON_KIND=room + ATRIUM_ROOM_ID, ATRIUM_ROOM_WS_URL). Ledger SQLite path: ATRIUM_OBP_STORE_ROOT or <dataDir>/obp (reused for durable ledger_seq). JSON logs: ATRIUM_DAEMON_JSON=1 or --json.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugins": {
      "types": "./src/plugins.ts",
      "import": "./src/plugins.ts",
      "default": "./src/plugins.ts"
    },
    "./bin": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/main.ts",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "@khoralabs/atrium-auth": "workspace:*",
    "@khoralabs/atrium-client": "workspace:*",
    "@khoralabs/atrium-plugin-inbox-buffer": "workspace:*",
    "@khoralabs/obp-v2-frames-impl": "workspace:*",
    "@khoralabs/obp-v2-persistence": "workspace:*",
    "@noble/ed25519": "^3.1.0",
    "iso-base": "^4.2.1",
    "iso-signatures": "^0.5.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
