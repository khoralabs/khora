{
  "name": "@cfd/atrium-cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "atrium": "./src/cli.ts"
  },
  "exports": {
    "./plugins": {
      "types": "./src/plugins.ts",
      "import": "./src/plugins.ts",
      "default": "./src/plugins.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "@cfd/atrium-client": "workspace:*",
    "@cfd/atrium-contracts": "workspace:*",
    "@cfd/atrium-plugin-inbox-buffer": "workspace:*",
    "@cfd/atrium-plugin-profile-sync": "workspace:*",
    "@cfd/atrium-plugin-telemetry": "workspace:*",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
