# Copy to .env. Bun loads .env automatically when you `bun run dev`.

PORT=3000

# Better Auth — must match where this app is served (defaults to http://localhost:$PORT)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ATRIUM_AUTH_DATABASE_PATH=./data/auth.sqlite
ADMIN_EMAIL_ALLOWLIST=you@company.com

# AWS SES (OTP email delivery). In SES sandbox, To addresses must also be verified in AWS.
# Local dev: set ATRIUM_AUTH_OTP_LOG=true to print the code in the server log instead of sending mail.
ATRIUM_AUTH_OTP_LOG=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=noreply@example.com

# Atrium server for admin stats BFF
ATRIUM_BASE_URL=http://localhost:8788
ATRIUM_INTERNAL_SECRET=change-me-long-random-secret
