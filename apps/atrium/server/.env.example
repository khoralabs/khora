# Copy to .env and adjust. Bun loads .env automatically when you `bun run`.

# --- required: SQLite files (parent dirs are created on startup) ---
ATRIUM_CATALOG_PATH=./data/atrium-catalog.sqlite
ATRIUM_FRAMES_DB_PATH=./data/atrium-frames.sqlite

# --- HTTP ---
# Listening port (default 8788 if unset or invalid)
PORT=8788

# Optional relay tenant key (library default is "relay" when unset)
# ATRIUM_RELAY_TENANT_KEY=

# --- parallel ingress (optional; default is Bun HTTP only) ---
# Unary: unset / "http" = HTTP only; "stdio" = NDJSON stdin/out alongside HTTP
# ATRIUM_HOST_UNARY_TRANSPORT=http
# ATRIUM_HOST_UNARY_TRANSPORT=stdio

# Duplex: unset / "off" = none; "unix" = Unix socket (opaque binary after JSON handshake line)
# ATRIUM_HOST_DUPLEX_INGRESS=off
# ATRIUM_HOST_DUPLEX_INGRESS=unix
# ATRIUM_HOST_DUPLEX_UNIX_PATH=/tmp/atrium-v2-duplex.sock

# --- invites (read by @khoralabs/atrium-host / createAtriumHost) ---
# Required if ATRIUM_INVITE_REQUIRED=1 or ATRIUM_INVITE_SEED_TOKENS is non-empty
# ATRIUM_INVITE_PEPPER=change-me-long-random-secret
# ATRIUM_INVITE_REQUIRED=1
# Max invites minted per successful registration (default 10, cap 500)
# ATRIUM_INVITES_PER_REGISTRATION=10
# Bootstrap plaintext tokens (comma- or newline-separated); hashed with pepper on startup
# ATRIUM_INVITE_SEED_TOKENS=

# --- rate limits (requests per minute; omit to use defaults) ---
# ATRIUM_RL_REGISTER_PER_MIN_PER_IP=30
# ATRIUM_RL_REGISTER_PER_MIN_PER_DID=15
# ATRIUM_RL_POSTS_PER_MIN_PER_DID=120
# ATRIUM_RL_TOPICS_PER_MIN_PER_DID=120
# ATRIUM_RL_PROFILE_PATCH_PER_MIN_PER_DID=60
# ATRIUM_RL_INBOX_PER_MIN_PER_DID=120
# ATRIUM_RL_DEFAULT_PER_MIN_PER_IP=900
# ATRIUM_RL_INVITE_PREVIEW_PER_MIN_PER_IP=30
# ATRIUM_RL_INVITES_LIST_PER_MIN_PER_DID=60
# ATRIUM_RL_ROOMS_CREATE_PER_MIN_PER_DID=30
# ATRIUM_RL_ROOMS_TICKET_PER_MIN_PER_DID=60
# ATRIUM_RL_ROOMS_JOIN_PER_MIN_PER_DID=30
# ATRIUM_RL_RELATIONSHIPS_LIST_PER_MIN_PER_DID=60
