    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@khoralabs/agent-relay": "workspace:*",
    "@khoralabs/atrium-auth": "workspace:*",
    "@khoralabs/atrium-contracts": "workspace:*",
    "@khoralabs/atrium-host": "workspace:*",
    "@khoralabs/atrium-transport": "workspace:*",
    "@khoralabs/duplex-byte-stream": "workspace:*",
    "pino": "^10.3.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
