{
  "name": "@khoralabs/khora-server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "bun ./scripts/install-litestream.ts",
    "start": "NODE_ENV=production bun run scripts/start-khora.ts",
    "start:server": "bun run src/index.ts",
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:darwin-arm64": "bun run scripts/build.ts bun-darwin-arm64",
    "build:linux-x64": "bun run scripts/build.ts bun-linux-x64",
    "build:linux-arm64": "bun run scripts/build.ts bun-linux-arm64",
    "build:all": "bun run scripts/build.ts bun-darwin-arm64 && bun run scripts/build.ts bun-linux-x64 && bun run scripts/build.ts bun-linux-arm64"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.0",
    "@khoralabs/colonnade": "workspace:*",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/khora-client": "workspace:*",
    "@khoralabs/khora-contracts": "workspace:*",
    "@khoralabs/khora-host": "workspace:*",
    "@khoralabs/memories-node": "catalog:",
    "@khoralabs/memories-service": "catalog:",
    "@khoralabs/observability": "workspace:*",
    "@khoralabs/percolator": "workspace:*",
    "@khoralabs/sqlite-crypto": "catalog:",
    "@opentelemetry/api": "catalog:",
    "ai": "^6"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
