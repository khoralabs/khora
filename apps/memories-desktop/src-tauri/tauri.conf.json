{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memories",
  "version": "0.1.0",
  "identifier": "com.cfd.memories.desktop",
  "build": {
    "frontendDist": "../dist-placeholder",
    "devUrl": "http://127.0.0.1:31416",
    "beforeDevCommand": "cd ../memories && PORT=31416 bun run dev",
    "beforeBuildCommand": "bun run compile-sidecar"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/memories-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
