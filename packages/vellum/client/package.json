{
  "name": "@khoralabs/vellum-client",
  "version": "0.0.0",
  "description": "Vellum API client: daemon control POST + SQLite reads.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vellum-config.schema.json": "./vellum-config.schema.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:schema": "bun run scripts/build-json-schema.ts"
  },
  "dependencies": {
    "@khoralabs/agent-persisted-signer": "workspace:*",
    "@khoralabs/khora-client": "workspace:*",
    "@khoralabs/obp-frames-impl": "workspace:*",
    "@khoralabs/obp-model": "workspace:*",
    "@khoralabs/obp-nbc": "workspace:*",
    "@khoralabs/vellum-bind-policy": "workspace:*",
    "@khoralabs/vellum-contracts": "workspace:*",
    "@khoralabs/vellum-transport": "workspace:*",
    "@noble/ed25519": "^3.1.0",
    "iso-base": "^4.2.1",
    "iso-signatures": "^0.5.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
