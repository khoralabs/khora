{
  "name": "@khoralabs/khora-host",
  "version": "0.1.9",
  "description": "Khora host domain library.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/khora.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/khoralabs/khora/tree/main/packages/host",
  "bugs": "https://github.com/khoralabs/khora/issues",
  "keywords": [
    "khora",
    "host",
    "khoralabs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./persistence": {
      "types": "./src/persistence/core/index.ts",
      "import": "./src/persistence/core/index.ts",
      "default": "./src/persistence/core/index.ts"
    },
    "./sqlite": {
      "types": "./src/persistence/sqlite/index.ts",
      "import": "./src/persistence/sqlite/index.ts",
      "default": "./src/persistence/sqlite/index.ts"
    },
    "./testing": {
      "types": "./src/persistence/testing/index.ts",
      "import": "./src/persistence/testing/index.ts",
      "default": "./src/persistence/testing/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts",
      "default": "./src/http/index.ts"
    },
    "./bootstrap": {
      "types": "./src/bootstrap/index.ts",
      "import": "./src/bootstrap/index.ts",
      "default": "./src/bootstrap/index.ts"
    },
    "./discovery/search": {
      "types": "./src/discovery/search/index.ts",
      "import": "./src/discovery/search/index.ts",
      "default": "./src/discovery/search/index.ts"
    },
    "./discovery/subscriptions": {
      "types": "./src/discovery/subscriptions/index.ts",
      "import": "./src/discovery/subscriptions/index.ts",
      "default": "./src/discovery/subscriptions/index.ts"
    },
    "./posts": {
      "types": "./src/posts/index.ts",
      "import": "./src/posts/index.ts",
      "default": "./src/posts/index.ts"
    },
    "./inbox": {
      "types": "./src/inbox/index.ts",
      "import": "./src/inbox/index.ts",
      "default": "./src/inbox/index.ts"
    },
    "./registration": {
      "types": "./src/registration/index.ts",
      "import": "./src/registration/index.ts",
      "default": "./src/registration/index.ts"
    },
    "./invites": {
      "types": "./src/invites/index.ts",
      "import": "./src/invites/index.ts",
      "default": "./src/invites/index.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@khoralabs/colonnade": "workspace:*",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/khora-contracts": "workspace:*",
    "@khoralabs/memories-node": "catalog:",
    "@khoralabs/memories-service": "catalog:",
    "@khoralabs/observability": "workspace:*",
    "@khoralabs/percolator": "workspace:*",
    "@khoralabs/khora-registry": "workspace:*",
    "@khoralabs/sourcemaps": "catalog:",
    "@khoralabs/sqlite-crypto": "catalog:",
    "@khoralabs/sqlite-migrate": "catalog:",
    "sqlite-vec": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@khoralabs/khora-client": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
