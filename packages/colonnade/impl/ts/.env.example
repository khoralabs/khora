# @khoralabs/colonnade-persistence
#
# This package does not read process.env. Values below are what a host
# application typically maps from env into:
#   - createSqliteColonnadeCluster({ cellsDirectory, poolCount? })
#   - createCellPersistenceClient(...)
#   - new ColonnadePublicationClient(...)
#
# The Khora server uses KHORA_DATA_DIR; reuse it or pass paths explicitly.

# --- Host persistence root ---
KHORA_DATA_DIR=./data

# --- Derived by default under KHORA_DATA_DIR ---
# khora-catalog.sqlite — catalog KV, standing queries, …
# cells/               — colonnade shard SQLite files

# --- Optional per-path overrides ---
# KHORA_CATALOG_PATH=./data/khora-catalog.sqlite
# KHORA_CELLS_DIR=./data/cells

# --- Shard pool size for assignPrincipalToCell (optional) ---
# Default when unset in Khora server: 16
# KHORA_CELL_POOL_COUNT=16

# Khora server: cell DB in Bun Workers (bench `--cell-workers`) vs main thread. Default: workers on.
# KHORA_COLONNADE_CELL_WORKERS=1

# --- Same-process Khora / catalog persistence (not read by this package) ---
# KHORA_RELAY_TENANT_KEY=
