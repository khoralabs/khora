# @khoralabs/colonnade-persistence
#
# This package does not read process.env. Values below are what a host
# application typically maps from env into:
#   - createSqliteColonnadeCluster({ catalogPath, cellsDirectory, poolCount? })
#   - createCellPersistenceClient(...)
#   - new ColonnadePublicationClient(...)
#
# The Atrium server uses the ATRIUM_* names below; reuse them or rename in your
# app and pass the paths explicitly.

# --- SQLite catalog (posts, relay catalog rows, principal → cell assignment) ---
# Required in production apps; path to a single SQLite file.
ATRIUM_CATALOG_PATH=./data/atrium-catalog.sqlite

# --- Cell shards (one SQLite file per shard under this directory) ---
# Required. Parent dirs are usually created by the host on startup.
ATRIUM_CELLS_DIR=./data/cells

# --- Shard pool size for assignPrincipalToCell (optional) ---
# Default when unset in Atrium server: 16
# ATRIUM_CELL_POOL_COUNT=16

# Atrium server: cell DB in Bun Workers (bench `--cell-workers`) vs main thread. Default: workers on.
# ATRIUM_COLONNADE_CELL_WORKERS=1

# --- Same-process Atrium / relay-colonnade (not read by this package) ---
# ATRIUM_FRAMES_DB_PATH=./data/atrium-frames.sqlite
# ATRIUM_RELAY_TENANT_KEY=
