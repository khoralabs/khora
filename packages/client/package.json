{
  "name": "@khoralabs/khora-client",
  "version": "0.1.6",
  "description": "Typed HTTP/WS client for Khora hosts.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/khora.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/khoralabs/khora/tree/main/packages/client",
  "bugs": "https://github.com/khoralabs/khora/issues",
  "keywords": [
    "khora",
    "client",
    "khoralabs"
  ],
  "files": [
    "dist",
    "khora-config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "import": "./src/transport/index.ts",
      "default": "./src/transport/index.ts"
    },
    "./transport/byte-stream": {
      "types": "./src/transport/byte-stream/index.ts",
      "import": "./src/transport/byte-stream/index.ts",
      "default": "./src/transport/byte-stream/index.ts"
    },
    "./khora-config.schema.json": "./khora-config.schema.json"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:schema": "bun run scripts/build-json-schema.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@khoralabs/did-key-identity": "^0.1.0",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/khora-contracts": "workspace:*",
    "zod": "^4",
    "@noble/ed25519": "^3.1.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
