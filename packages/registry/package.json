{
  "name": "@khoralabs/registry",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./persistence": {
      "types": "./src/persistence/core/index.ts",
      "import": "./src/persistence/core/index.ts",
      "default": "./src/persistence/core/index.ts"
    },
    "./sqlite": {
      "types": "./src/persistence/sqlite/index.ts",
      "import": "./src/persistence/sqlite/index.ts",
      "default": "./src/persistence/sqlite/index.ts"
    },
    "./turso-serverless": {
      "types": "./src/persistence/turso-serverless/index.ts",
      "import": "./src/persistence/turso-serverless/index.ts",
      "default": "./src/persistence/turso-serverless/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./accounts": {
      "types": "./src/accounts/index.ts",
      "import": "./src/accounts/index.ts",
      "default": "./src/accounts/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "import": "./src/catalog/index.ts",
      "default": "./src/catalog/index.ts"
    },
    "./email-confirm": {
      "types": "./src/email-confirm/index.ts",
      "import": "./src/email-confirm/index.ts",
      "default": "./src/email-confirm/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@khoralabs/admin-token": "workspace:*",
    "@khoralabs/colonnade": "workspace:*",
    "@khoralabs/khora-auth": "workspace:*",
    "@khoralabs/observability": "workspace:*",
    "@khoralabs/sqlite-crypto": "^0.1.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@tursodatabase/serverless": "^1.2.3"
  }
}
