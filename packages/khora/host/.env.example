# @khoralabs/khora-host
#
# The host library does not read persistence paths or invite env directly.
# Wire everything in your composition root (e.g. apps/khora/server):
#   - paths: apps/khora/server/.env.example
#   - invites: packages/khora/invites (ATRIUM_INVITE_* env)
#   - memories/embedding: apps/khora/server/src/memories-env.ts
#
# Pass an KhoraHostDeps object to createKhoraHost(deps).
