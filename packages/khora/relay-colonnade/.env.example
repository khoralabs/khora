# @khoralabs/relay-colonnade
#
# This package does not read process.env. Wire these from your host’s env into
# createRelayColonnadeSocial / catalog adapters, e.g.:
#   resolveKhoraPersistencePaths() → catalogPath, framesDbPath
#
# Default layout under KHORA_DATA_DIR (see apps/khora/server/.env.example):
#   khora-catalog.sqlite, khora-frames.sqlite, cells/, khora-memories.sqlite

# --- Host persistence root (Khora server reads this) ---
KHORA_DATA_DIR=./data

# --- Optional per-path overrides ---
# KHORA_CATALOG_PATH=./data/khora-catalog.sqlite
# KHORA_FRAMES_DB_PATH=./data/khora-frames.sqlite

# --- Optional relay tenant key prefix in catalog keys (library default: "relay") ---
# KHORA_RELAY_TENANT_KEY=

# --- Same-process Khora / colonnade (not read by this package; for one-file deploy docs) ---
# KHORA_CELLS_DIR=./data/cells
# KHORA_CELL_POOL_COUNT=16
