{
  "name": "@khoralabs/khora-contracts",
  "version": "0.0.0",
  "description": "Zod schemas and shared types for the Khora HTTP/WS wire format.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/khora.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/khoralabs/khora/tree/main/packages/contracts",
  "bugs": "https://github.com/khoralabs/khora/issues",
  "keywords": [
    "khora",
    "contracts",
    "zod",
    "khoralabs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && bun build ./src/index.ts --outfile=dist/index.js --target=node --format=esm --packages=external",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
