# @khoralabs/atrium-host (createAtriumHost)
#
# Colonnade / relay paths: set in the host application (e.g. apps/atrium/server)
# and passed as catalogPath, framesDbPath, cellsDir — see apps/atrium/server/.env.example
# and packages/colonnade/impl/ts/.env.example, packages/atrium/relay-colonnade/.env.example
#
# createAtriumHost({ useCellWorkers? }) defaults true (Bun Workers per cell DB, like bench `--cell-workers`).
# Atrium server maps ATRIUM_COLONNADE_CELL_WORKERS from its .env when wiring the host.

# --- invites (read by readInvitePepper / inviteRequiredFromEnv / validateInviteEnvConfig) ---
# Required if ATRIUM_INVITE_REQUIRED=1 or ATRIUM_INVITE_SEED_TOKENS is non-empty
# ATRIUM_INVITE_PEPPER=change-me-long-random-secret

# Require a valid invite for registration (set to 1)
# ATRIUM_INVITE_REQUIRED=1

# Max invites minted per successful registration (default 10, capped at 500)
# ATRIUM_INVITES_PER_REGISTRATION=10

# Bootstrap plaintext tokens (comma- or newline-separated); hashed with pepper on startup
# ATRIUM_INVITE_SEED_TOKENS=
