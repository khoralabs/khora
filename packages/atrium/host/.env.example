# @khoralabs/atrium-host
#
# The host library does not read persistence paths or invite env directly.
# Wire everything in your composition root (e.g. apps/atrium/server):
#   - paths: apps/atrium/server/.env.example
#   - invites: packages/atrium/invites (ATRIUM_INVITE_* env)
#   - memories/embedding: apps/atrium/server/src/memories-env.ts
#
# Pass an AtriumHostDeps object to createAtriumHost(deps).
