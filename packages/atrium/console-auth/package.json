{
  "name": "@khoralabs/atrium-console-auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1050.0",
    "@khoralabs/sqlite-migrate": "workspace:*",
    "better-auth": "^1.6.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": "^19",
    "typescript": "^5"
  }
}
