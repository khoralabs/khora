{
  "name": "@cfd/agent-kernel",
  "devDependencies": {
    "@tsconfig/node20": "20.1.8",
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "test:with-sqlite": "bash scripts/test-with-homebrew-sqlite.sh",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "check": "biome check . && bun run --filter @cfd/memories-spec validate && bun run --filter @cfd/agent-identity-spec validate && bun run --filter @cfd/obp-spec validate",
    "check:write": "biome check --write .",
    "context": "bun run scripts/context.ts"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/atrium/*",
    "apps/atrium/plugins/*",
    "packages/libs/*",
    "packages/agent/*",
    "packages/memories/*",
    "packages/memories/persistence/*",
    "packages/memories/agents/*",
    "packages/memories/react/*",
    "packages/obp/*",
    "packages/obp/agents/*",
    "packages/obp/persistence/*",
    "packages/swarm/*"
  ]
}
