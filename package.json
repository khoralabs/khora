{
  "name": "@khoralabs/agent-kernel",
  "devDependencies": {
    "@tsconfig/node20": "20.1.8",
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "test:with-sqlite": "bash scripts/test-with-homebrew-sqlite.sh",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "check": "biome check . && bun run --filter @khoralabs/memories-spec validate && bun run --filter @khoralabs/agent-identity-spec validate && bun run --filter @khoralabs/obp-spec validate",
    "check:write": "biome check --write .",
    "context": "bun run scripts/context.ts",
    "start:atrium:server": "bun run --filter @khoralabs/atrium-server start"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/atrium/*",
    "apps/khoralabs/*",
    "packages/libs/*",
    "packages/agent/*",
    "packages/memories/*",
    "packages/memories/persistence/*",
    "packages/memories/agents/*",
    "packages/memories/react/*",
    "packages/obp/*",
    "packages/obp/react/examples",
    "packages/obp/agents/*",
    "packages/obp/persistence/*",
    "packages/obp/v2/errors/impl/ts",
    "packages/obp/v2/frames/impl/ts",
    "packages/obp/v2/model/impl/ts",
    "packages/obp/v2/persistence/impl/ts",
    "packages/obp/v2/persistence/sqlite",
    "packages/obp/v2/session/impl/ts",
    "packages/obp/v2/nbc/impl/ts",
    "packages/obp/v2/transport-http2/impl/ts",
    "packages/obp/v2/transport-ws/impl/ts",
    "packages/atrium/*",
    "packages/percolator",
    "packages/percolator-sqlite",
    "packages/khoralabs/*",
    "packages/colonnade/impl/ts",
    "packages/vellum/*",
    "packages/cli/*",
    "apps/vellum/*"
  ]
}
