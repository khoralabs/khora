{
  "name": "@cfd/agent-kernel",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "check": "biome check . && bun run --filter @cfd/memories-spec validate && bun run --filter @cfd/agent-identity-spec validate",
    "check:write": "biome check --write ."
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
