{
  "name": "@khoralabs/agent-kernel",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@khoralabs/agent-review": "^0.2.2",
    "@microsoft/api-extractor": "^7.58.9",
    "@tsconfig/node20": "20.1.8",
    "@types/bun": "catalog:",
    "@types/parse-gitignore": "^1.0.2",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "private": true,
  "overrides": {
    "kysely": "0.28.17"
  },
  "scripts": {
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "bun run --filter './packages/*' typecheck && bun run --filter './apps/*' typecheck && bun run --filter './vendor/libs/packages/*' typecheck",
    "test": "bun test",
    "test:e2e": "bun test apps/e2e",
    "start:khora:server": "bun run --filter @khoralabs/khora-server start",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:update": "git submodule update --remote --merge vendor/libs && bun install",
    "submodules:update:libs": "git submodule update --remote --merge vendor/libs && bun install",
    "prepare": "husky",
    "agent-review": "agent-review",
    "review": "agent-review run --scope staged --include-workstream"
  },
  "type": "module",
  "dependencies": {
    "@khoralabs/memories-node": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "vendor/libs/packages/*/**",
      "study/**"
    ],
    "catalog": {
      "@types/bun": "latest",
      "typescript": "^5",
      "@khoralabs/did-key-identity": "^0.1.0",
      "@khoralabs/sqlite-crypto": "^0.1.0",
      "@khoralabs/sourcemaps": "^0.1.0",
      "@khoralabs/memories-node": "^0.8.0",
      "@khoralabs/memories-service": "^0.8.0",
      "@opentelemetry/api": "^1.9.0",
      "@tursodatabase/serverless": "^1.2.3",
      "@noble/ed25519": "^3.1.0",
      "zod": "^4"
    }
  }
}
