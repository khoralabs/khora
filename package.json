{
  "name": "@khoralabs/agent-kernel",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tsconfig/node20": "20.1.8",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "overrides": {
    "kysely": "0.28.17",
    "@khoralabs/memories-node": "0.6.1",
    "@khoralabs/memories-agents": "0.6.1",
    "@khoralabs/memories-service": "0.6.1",
    "@khoralabs/memories-react-graph": "0.6.1"
  },
  "scripts": {
    "test:with-sqlite": "bash scripts/test-with-homebrew-sqlite.sh",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "context": "bun run scripts/context.ts",
    "start:khora:server": "bun run --filter @khoralabs/khora-server start",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:update": "git submodule update --remote --merge vendor/chat vendor/libs && bun install",
    "submodules:update:chat": "git submodule update --remote --merge vendor/chat && bun install",
    "submodules:update:libs": "git submodule update --remote --merge vendor/libs && bun install",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "@khoralabs/memories-node": "^0.6.1"
  },
  "workspaces": [
    "apps/*",
    "apps/khora/cli",
    "apps/khora/daemon",
    "apps/khora/plugins/*",
    "apps/khora/admin",
    "apps/khora/registry",
    "apps/khora/server",
    "apps/khoralabs/*/**",
    "packages/*",
    "vendor/libs/packages/*/**",
    "vendor/chat/*/**",
    "packages/khora/*/**",
    "packages/registry/*/**",
    "vendor/chat/**",
    "vendor/libs/**",
    "study/**"
  ]
}
