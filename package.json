{
  "name": "@khoralabs/agent-kernel",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tsconfig/node20": "20.1.8",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "overrides": {
    "kysely": "0.28.17"
  },
  "scripts": {
    "test:with-sqlite": "bash scripts/test-with-homebrew-sqlite.sh",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "context": "bun run scripts/context.ts",
    "start:khora:server": "bun run --filter @khoralabs/khora-server start",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:update": "git submodule update --remote --merge vendor/memories vendor/obp vendor/relay && bun install",
    "submodules:update:memories": "git submodule update --remote --merge vendor/memories && bun install",
    "submodules:update:obp": "git submodule update --remote --merge vendor/obp && bun install",
    "submodules:update:relay": "git submodule update --remote --merge vendor/relay && bun install",
    "prepare": "husky"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/khora/*/**",
    "apps/khoralabs/*/**",
    "apps/vellum/*/**",
    "packages/*",
    "packages/libs/*/**",
    "packages/chat/*/**",
    "packages/khora/*/**",
    "packages/percolator/*/**",
    "packages/registry/*/**",
    "packages/colonnade/*/**",
    "packages/vellum/*/**",
    "packages/cli/*/**",
    "vendor/*/**",
    "vendor/memories/packages/*/**",
    "vendor/obp/packages/*/**",
    "vendor/relay/*/**"
  ]
}
