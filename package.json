{
  "name": "@khoralabs/agent-kernel",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tsconfig/node20": "20.1.8",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "overrides": {
    "kysely": "0.28.17"
  },
  "scripts": {
    "test:with-sqlite": "bash scripts/test-with-homebrew-sqlite.sh",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "check": "biome check . && bun run --filter @khoralabs/memories-spec validate && bun run --filter @khoralabs/agent-identity-spec validate && bash packages/obp/packages/validate-all.sh",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "context": "bun run scripts/context.ts",
    "start:khora:server": "bun run --filter @khoralabs/khora-server start",
    "prepare": "husky"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/khora/*",
    "apps/khora/plugins/*",
    "apps/khoralabs/*",
    "apps/vellum/*",
    "packages/*",
    "packages/libs/*",
    "packages/memories/packages/*",
    "packages/memories/packages/persistence/*",
    "packages/memories/packages/agents/*",
    "packages/memories/packages/react/*",
    "packages/obp/packages/*",
    "packages/obp/packages/react/examples",
    "packages/obp/packages/agents/*",
    "packages/obp/packages/persistence/*",
    "packages/obp/packages/errors/impl/ts",
    "packages/obp/packages/frames/impl/ts",
    "packages/obp/packages/model/impl/ts",
    "packages/obp/packages/persistence/impl/ts",
    "packages/obp/packages/persistence/sqlite",
    "packages/obp/packages/session/impl/ts",
    "packages/obp/packages/nbc/impl/ts",
    "packages/obp/packages/transport-http2/impl/ts",
    "packages/obp/packages/transport-ws/impl/ts",
    "packages/obp/packages/frame-relay/spec",
    "packages/obp/packages/frame-relay/impl/ts",
    "packages/obp/packages/frame-relay/sqlite",
    "packages/khora/*",
    "packages/percolator/*",
    "packages/registry/*",
    "packages/colonnade/crypto",
    "packages/colonnade/impl/ts",
    "packages/vellum/*",
    "packages/cli/*"
  ]
}
